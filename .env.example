# ============================================================
# Jarvis — Configuração de Ambiente
# Copie para .env e ajuste
# ============================================================

# -------------------------------------------------------
# PROVIDER LLM — escolha um:
#   groq       → cloud gratuito, rápido (PADRÃO — recomendado)
#   anthropic  → Claude (melhor qualidade, suporte a visão multimodal)
#   ollama     → local, offline, ilimitado
# -------------------------------------------------------
LLM_PROVIDER=groq

# -------------------------------------------------------
# Anthropic Claude (PADRÃO)
# Obtenha sua API key em: https://console.anthropic.com
# -------------------------------------------------------
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Modelo Anthropic a usar:
#   claude-sonnet-4-6         → RECOMENDADO: melhor qualidade + visão de tela
#   claude-haiku-4-5-20251001 → mais rápido e barato, sem visão multimodal de alta resolução
JARVIS_MODEL=claude-sonnet-4-6

# -------------------------------------------------------
# Groq (fallback gratuito — crie conta em https://console.groq.com)
# Ignorado se LLM_PROVIDER=anthropic
# -------------------------------------------------------
GROQ_API_KEY=sua_chave_groq_aqui

# Modelos disponíveis (todos gratuitos no free tier):
#   llama-3.1-8b-instant     → RECOMENDADO p/ voz: rápido, 500k tokens/dia
#   llama-3.3-70b-versatile  → mais inteligente, mas só 100k tokens/dia
GROQ_MODEL=llama-3.1-8b-instant

# -------------------------------------------------------
# Ollama (local, ignorado se LLM_PROVIDER!=ollama)
# -------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# -------------------------------------------------------
# CONFIGURAÇÕES GERAIS
# -------------------------------------------------------

JARVIS_LANGUAGE=pt

# TTS — voz de saída
JARVIS_TTS_VOICE=pt-BR-FranciscaNeural
JARVIS_TTS_RATE=+10%
# True = edge-tts (melhor qualidade, só o TTS usa internet)
# False = pyttsx3 (100% offline)
JARVIS_TTS_EDGE=True

# STT — reconhecimento de voz (roda local)
# tiny (39MB) | base (74MB) | small (244MB) | medium (769MB)
WHISPER_MODEL=small

# OCR (Windows) — opcional, instale Tesseract em: https://github.com/UB-Mannheim/tesseract/wiki
# Se não instalado, visão multimodal do Claude ainda funciona com screenshot direto
TESSERACT_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe

# -------------------------------------------------------
# VISÃO — Configurações de captura de tela
# -------------------------------------------------------

# Idade máxima do frame (segundos) antes de forçar nova captura ao responder
VISION_FRAME_MAX_AGE_S=2.0

# Ativa logs de debug de visão (resolução, timestamp, tamanho do JPEG)
VISION_DEBUG=false

# Qualidade JPEG do screenshot enviado ao LLM (1-95, menor = mais rápido/barato)
VISION_JPEG_QUALITY=50

# Largura máxima do screenshot enviado ao LLM (px)
VISION_MAX_WIDTH=1280

# Cooldown entre mensagens proativas (segundos)
PROACTIVITY_COOLDOWN=120

# -------------------------------------------------------
# GOOGLE DOCS — modo anotação
# Siga as instruções em jarvis/integrations/gdocs.py
# -------------------------------------------------------
GDOCS_CREDENTIALS_PATH=credentials.json
GDOCS_TOKEN_PATH=token.json
